  // },
  // {
  //   icon: 'fa-solid fa-money-bill-wave',
  //   title: 'Ekonomická závislost',
  //   description:
  //     'Mnohá média jsou závislá na politicky propojených inzerentech. Ekonomický tlak se mění v tlak redakční.',
  // },
  // {
  //   icon: 'fa-solid fa-globe',
  //   title: 'Dezinformace a propaganda',
  //   description:
  //     'Dezinformační weby a zahraniční vlivové operace podkopávají důvěru v seriózní žurnalistiku a ohrožují demokratický diskurz.',
  // },
  {
    icon: 'fa-solid fa-tv',
    title: 'Je to i o pořadech, které sledujete každý den.',
    description:
      'Škrty v takovém rozsahu nezasáhnou v prvním řadě zpravodajství. To se propíše na nákladech České televize. Jako první jsou ohroženy nejnákladnější položky: Sport, Původní česká tvorba, StarDance, Peče celá zem, Dětské vysílání, včetně ČT Déčko.',
  },
  {
    icon: 'fa-solid fa-sack-dollar',
    title: 'Stejně si to zaplatíme',
    description:
      'Média veřejné služby nepřestanou existovat. Jen je budeme platit jinak — bez možnosti je ovlivnit. Poplatky se přesunou do vyšších daní nebo do stále více narůstajícího dluhu a nákladů na jeho správu.',
  },
  {
    icon: 'fa-solid fa-wrench',
    title: 'Zásahy do něčeho co funguje',
    description:
      'I přes některé nedostatky jsou ČT i ČRo podle Reuters institute mezi občany stále nejdůvěryhodnějšími médii v České republice a jakékoliv zásahy do jejich fungování si žádá pádné argumenty. Ty však chybí.',
  },
];
---

<section id="proc" class="reasons">
  <div class="container">
    <header class="reasons-header">
      <p class="section-label">Proč je to důležité</p>
      <h2 class="section-title">Svobodná média jsou v ohrožení</h2>
    </header>
    <ul class="reasons-grid" role="list">
      {
        reasons.map((reason) => (
          <li class="reason-card">
            <i class={`reason-icon ${reason.icon}`} aria-hidden="true"></i>
            <h3 class="reason-title">{reason.title}</h3>
            <p class="reason-desc">{reason.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reasons {
    background: var(--color-bg);
  }

  .reasons-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .reasons-header .section-subtitle {
    margin-inline: auto;
  }

  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
  }

  .reason-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem 1.75rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .reason-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .reason-icon {
    font-size: 1.75rem;
    display: block;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .reason-title {
    font-size: 1.1rem;
    color: var(--color-secondary);
    margin-bottom: 0.65rem;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .reason-desc {
    font-size: 0.92rem;
    color: var(--color-text-light);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .reasons-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .reasons-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
