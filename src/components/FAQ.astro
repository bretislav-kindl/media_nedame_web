---
// FAQ section component

const faqs = [
  {
    question: 'Kdo stojí za iniciativou Média nedáme?',
    answer:
      'Iniciativa vznikla z vůle studentů Filozofické fakulty UK, kterým není lhostejné v jaké zemi budeme společně žít. Stojí za ní studentský spolek Studentská rada (StRada), který nemá napojení na žádnou politickou stranu.',
  },
  {
    question: 'Co je to walkout a proč ho děláme?',
    answer:
      'Walkout je protestní odchod z výuky. Studenti opouštějí přednášky a semináře a scházejí se na náměstích, před školami a kampusech po celé republice. V Praze se například sejdeme na náměstí Jana Palacha, odkud budeme pochodovat k Ministerstvu kultury. Celá akce má za cíl dát studentům po celé republice možnost viditelně vyjádřit svůj nesouhlas s politickými tlaky na veřejnoprávní média.',
  },
  {
    question: 'Může se walkoutu zúčastnit každý?',
    answer:
      'Jedná se o studentskou iniciativu, ale může se k ní přidat každý, kdo souzní s myšlenkou akce. Považujeme za důležité dát příležitost všem vyjádřit svůj nesouhlas a nehodláme se omezovat pouze na hlas studentstva.',
  },
  {
    question: 'Jak mohu pomoci, i když nemohu přijít?',
    answer:
      'Sdílejte iniciativu a její myšlenky na sociálních sítích a ve svém okolí. Povídejte si o tématu se svým okolím a podporujte princip veřejné a odborné diskuze. Kreativitě se však meze nekladou. Zakládejte nové projekty a v případě potřeby nás neváhejte kontaktovat.',
  },

];
---

<section id="faq" class="faq">
  <div class="container">
    <header class="faq-header">
      <p class="section-label">Časté dotazy</p>
      <h2 class="section-title">Máte otázky?</h2>
      <p class="section-subtitle">Odpovídáme na nejčastěji kladené otázky o iniciativě.</p>
    </header>
    <dl class="faq-list">
      {
        faqs.map((faq, index) => (
          <div class="faq-item">
            <dt>
              <button
                class="faq-question"
                aria-expanded="false"
                aria-controls={`faq-answer-${index}`}
              >
                <span>{faq.question}</span>
                <i class="fa-solid fa-plus faq-icon" aria-hidden="true"></i>
              </button>
            </dt>
            <dd class="faq-answer" id={`faq-answer-${index}`} hidden>
              <p>{faq.answer}</p>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const faqButtons = document.querySelectorAll<HTMLButtonElement>('.faq-question');

  faqButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answerId = btn.getAttribute('aria-controls');
      const answer = answerId ? document.getElementById(answerId) : null;

      // Close all other items
      faqButtons.forEach((other) => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          const otherId = other.getAttribute('aria-controls');
          const otherAnswer = otherId ? document.getElementById(otherId) : null;
          if (otherAnswer) otherAnswer.hidden = true;
          const otherIcon = other.querySelector('.faq-icon');
          if (otherIcon) {
            otherIcon.classList.remove('fa-minus');
            otherIcon.classList.add('fa-plus');
          }
        }
      });

      btn.setAttribute('aria-expanded', String(!expanded));
      if (answer) answer.hidden = expanded;
      const icon = btn.querySelector('.faq-icon');
      if (icon) {
        if (expanded) {
          icon.classList.remove('fa-minus');
          icon.classList.add('fa-plus');
        } else {
          icon.classList.remove('fa-plus');
          icon.classList.add('fa-minus');
        }
      }
    });
  });
</script>

<style>
  .faq {
    background: var(--color-bg-dark);
    color: rgba(255, 255, 255, 0.85);
  }

  .faq-header .section-title {
    color: #fff;
  }

  .faq-header .section-label {
    color: var(--color-primary);
  }

  .faq-header .section-subtitle {
    color: rgba(255, 255, 255, 0.65);
  }

  .faq-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .faq-header .section-subtitle {
    margin-inline: auto;
  }

  .faq-list {
    max-width: 760px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .faq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-size: 0.97rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    transition: background 0.15s;
  }

  .faq-question:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .faq-question[aria-expanded='true'] {
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-primary);
  }

  .faq-icon {
    font-size: 0.85rem;
    flex-shrink: 0;
    color: var(--color-primary);
    width: 1.2em;
    text-align: center;
  }

  .faq-answer {
    padding: 0 1.5rem 1.25rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .faq-answer p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
  }

  .faq-contact-note {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: var(--color-text-light);
  }

  .faq-contact-email {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.15s;
  }

  .faq-contact-email:hover {
    opacity: 0.75;
  }

  .faq-media-contacts {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius);
  }

  .faq-media-contacts-title {
    font-weight: 700;
    margin-bottom: 0.75rem;
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .faq-media-contacts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .faq-media-contact {
    font-size: 0.92rem;
    line-height: 1.8;
    color: var(--color-text-light);
  }

  .faq-media-contact strong {
    color: var(--color-text);
    display: block;
    margin-bottom: 0.15rem;
  }

  @media (max-width: 500px) {
    .faq-media-contacts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
