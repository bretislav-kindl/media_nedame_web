---
// What we do / Actions section component

const prague = [
  {
    number: '01',
    title: 'Řekněte to dál',
    description:
      'Dejte si to vědět mezi sebou, ve škole, proberte to s pedagogy nebo ve školních radách. Sdílejte iniciativu na sociálních sítích – čím více lidí, tím silnější hlas.',
  },
  {
    number: '02',
    title: 'Přijďte na walkout',
    description:
      'Středa 22. dubna v 11:59 – náměstí Jana Palacha. Odejděte z výuky a připojte se k pochodu k ministerstvu kultury na obranu veřejnoprávních médií.',
  },
];

const outside = [
  {
    number: '01',
    title: 'Šiřte zprávu ve svém okolí',
    description:
      'Mluvte o situaci se spolužáky, přáteli a rodinou. Sdílejte iniciativu na sociálních sítích a pomozte zvýšit povědomí po celé zemi.',
  },
  {
    number: '02',
    title: 'Zorganizujte akci ve vaší škole',
    description:
      'Uspořádejte diskuzi, přednášku nebo symbolický walkout na vaší škole. Podrobné informace a materiály pro organizátory připravujeme – sledujte naše kanály.',
  },
  {
    number: '03',
    title: 'Více informací brzy',
    description:
      'Připravujeme další způsoby, jak se zapojit mimo Prahu. Zůstaňte v kontaktu – podrobnosti zveřejníme co nejdříve.',
  },
];
---

<section id="co-delame" class="what-we-do">
  <div class="container">
    <header class="section-header">
      <p class="section-label">Co děláme</p>
      <h2 class="section-title">Jak se zapojit</h2>
      <p class="section-subtitle">
        Každý z nás může přispět k ochraně veřejnoprávních médií – ať jste kdekoliv.
      </p>
    </header>

    <div class="audience-grid">
      <div class="audience-block">
        <div class="audience-label audience-label--prague">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          Jsem v Praze
        </div>
        <div class="steps-list">
          {prague.map((step) => (
            <div class="step-card step-card--prague">
              <span class="step-number">{step.number}</span>
              <div>
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="audience-divider" aria-hidden="true"></div>

      <div class="audience-block">
        <div class="audience-label audience-label--outside">
          <i class="fa-solid fa-map" aria-hidden="true"></i>
          Jsem mimo Prahu
        </div>
        <div class="steps-list">
          {outside.map((step) => (
            <div class="step-card step-card--outside">
              <span class="step-number">{step.number}</span>
              <div>
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .what-we-do {
    background: var(--color-bg-dark);
    color: #fff;
  }

  .what-we-do .section-label {
    color: var(--color-accent);
  }

  .what-we-do .section-title {
    color: #fff;
  }

  .what-we-do .section-subtitle {
    color: rgba(255, 255, 255, 0.7);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-header .section-subtitle {
    margin-inline: auto;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 0 3rem;
    align-items: start;
  }

  .audience-divider {
    background: rgba(255, 255, 255, 0.12);
    align-self: stretch;
  }

  .audience-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.45rem 0.9rem;
    border-radius: 2rem;
    margin-bottom: 1.75rem;
    width: fit-content;
  }

  .audience-label--prague {
    background: rgba(215, 38, 61, 0.2);
    color: #f28090;
    border: 1px solid rgba(215, 38, 61, 0.35);
  }

  .audience-label--outside {
    background: rgba(42, 90, 140, 0.3);
    color: #7fb3e0;
    border: 1px solid rgba(42, 90, 140, 0.45);
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .step-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: background 0.2s;
  }

  .step-card:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .step-number {
    font-size: 1.75rem;
    font-weight: 900;
    font-family: var(--font-heading);
    line-height: 1;
    flex-shrink: 0;
  }

  .step-card--prague .step-number {
    color: var(--color-primary);
  }

  .step-card--outside .step-number {
    color: var(--color-secondary-light);
  }

  .step-title {
    font-size: 1.05rem;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .step-desc {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .audience-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem 0;
    }

    .audience-divider {
      height: 1px;
      width: 100%;
      background: rgba(255, 255, 255, 0.12);
    }
  }
</style>
