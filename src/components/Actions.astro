---
// What we do / Actions section component

const actions = [
  {
    number: '01',
    title: 'Přijďte na walkout',
    description:
      'Středa 22. dubna v 11:59 – náměstí Jana Palacha. Odejděte z výuky a připojte se k pochodu k ministerstvu kultury na obranu veřejnoprávních médií.',
    accent: 'primary',
  },
  {
    number: '02',
    title: 'Šiřte dál – je za minutu dvanáct',
    description:
      'Dejte si to vědět mezi sebou, ve škole, proberte to s pedagogy nebo ve školních radách. Sdílejte iniciativu na sociálních sítích – čím více, tím silnější.',
    accent: 'secondary',
  },
  {
    number: '03',
    title: 'Podpořte veřejnoprávní média',
    description:
      'Předplaťte si ČT+, sledujte ČRo, sdílejte jejich obsah. Ukažte, že veřejnoprávní média mají diváky a posluchače, kteří si jich váží.',
    accent: 'accent',
  },
];
---

<section id="co-delame" class="what-we-do">
  <div class="container">
    <header class="section-header">
      <p class="section-label">Co děláme</p>
      <h2 class="section-title">Tři kroky, jak se zapojit</h2>
      <p class="section-subtitle">
        Každý z nás může přispět k ochraně veřejnoprávních médií. Tady je jak.
      </p>
    </header>
    <div class="actions-grid">
      {
        actions.map((action) => (
          <article class={`action-card action-card--${action.accent}`}>
            <span class="action-number" aria-hidden="true">
              {action.number}
            </span>
            <h3 class="action-title">{action.title}</h3>
            <p class="action-desc">{action.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .what-we-do {
    background: var(--color-bg-dark);
    color: #fff;
  }

  .what-we-do .section-label {
    color: var(--color-accent);
  }

  .what-we-do .section-title {
    color: #fff;
  }

  .what-we-do .section-subtitle {
    color: rgba(255, 255, 255, 0.7);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-header .section-subtitle {
    margin-inline: auto;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .action-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background 0.2s;
  }

  .action-card:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .action-number {
    font-size: 3rem;
    font-weight: 900;
    font-family: var(--font-heading);
    line-height: 1;
    opacity: 0.2;
  }

  .action-card--primary .action-number {
    color: var(--color-primary);
    opacity: 1;
  }

  .action-card--secondary .action-number {
    color: var(--color-secondary-light);
    opacity: 1;
  }

  .action-card--accent .action-number {
    color: var(--color-accent);
    opacity: 1;
  }

  .action-title {
    font-size: 1.25rem;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .action-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    flex: 1;
  }

  .action-link {
    display: inline-block;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-accent);
    transition: gap 0.15s;
  }

  .action-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .actions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
