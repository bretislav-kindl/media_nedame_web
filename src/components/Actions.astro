---
// What we do / Actions section component

const prague = [
  {
    number: '01',
    title: 'Krok 1',
    description: 'Rozšiřujte ve svém okolí povědomí o problematice veřejnoprávních médií a sdílejte iniciativu Media nedáme!',
  },
  {
    number: '02',
    title: 'Krok 2',
    description: 'Zorganizuj protestní walkout na své škole: ',
    link: { href: 'https://forms.gle/TDLyhBqtM1CLvETe7', text: 'MÉDIA NEDÁME! CELOREPUBLIKOVÁ VÝZVA STUDENTŮ' },
  },
  {
    number: '03',
    title: 'Krok 3',
    description: 'Připoj se k protestnímu shromáždění v 12:20 na náměstí Jana Palacha a následnému protestnímu průvodu k ministerstvu kultury',
  },
];

const outside = [
  {
    number: '01',
    title: 'Krok 1',
    description: 'Rozšiřujte ve svém okolí povědomí o problematice veřejnoprávních médií a sdílejte iniciativu Media nedáme!',
  },
  {
    number: '02',
    title: 'Krok 2',
    description: 'Zorganizuj protestní walkout na své škole: ',
    link: { href: 'https://forms.gle/TDLyhBqtM1CLvETe7', text: 'MÉDIA NEDÁME! CELOREPUBLIKOVÁ VÝZVA STUDENTŮ' },
  },
  {
    number: '03',
    title: 'Krok 3',
    description: 'Po protestním walkoutu zorganizujte navazující akci. Zde přikládáme pár nápadů:',
    list: [
      'shromáždění před školou',
      'symbolickou stávku',
      'společné čtení prohlášení',
      'veřejnou debatu',
      'hromadné shromáždění škol ve vašem městě',
      'společným potleskem podpořit zaměstnance ČT a ČRo',
    ],
  },
];
---

<section id="co-delame" class="what-we-do">
  <div class="container">
    <header class="section-header">
      <p class="section-label">Co děláme</p>
      <h2 class="section-title">Tři kroky, jak se zapojit</h2>
      <p class="section-subtitle">
        Každý z nás může přispět k ochraně veřejnoprávních médií. Tady je jak.
      </p>
    </header>

    <div class="audience-grid">
      <div class="audience-block">
        <div class="audience-label audience-label--prague">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          Chci se zapojit v Praze
        </div>
        <div class="steps-list">
          {prague.map((step) => (
            <div class="step-card step-card--prague">
              <span class="step-number">{step.number}</span>
              <div>
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">
                  {step.description}
                  {step.link && <a class="step-link" href={step.link.href} target="_blank" rel="noopener noreferrer">{step.link.text}</a>}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="audience-divider" aria-hidden="true"></div>

      <div class="audience-block">
        <div class="audience-label audience-label--outside">
          <i class="fa-solid fa-map" aria-hidden="true"></i>
          Chci se zapojit mimo Prahu
        </div>
        <div class="steps-list">
          {outside.map((step) => (
            <div class="step-card step-card--outside">
              <span class="step-number">{step.number}</span>
              <div>
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">
                  {step.description}
                  {step.link && <a class="step-link" href={step.link.href} target="_blank" rel="noopener noreferrer">{step.link.text}</a>}
                </p>
                {step.list && (
                  <ul class="step-list">
                    {step.list.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .what-we-do {
    background: var(--color-bg-dark);
    color: #fff;
  }

  .what-we-do .section-label {
    color: var(--color-accent);
  }

  .what-we-do .section-title {
    color: #fff;
  }

  .what-we-do .section-subtitle {
    color: rgba(255, 255, 255, 0.7);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-header .section-subtitle {
    margin-inline: auto;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 0 3rem;
    align-items: start;
  }

  .audience-divider {
    background: rgba(255, 255, 255, 0.12);
    align-self: stretch;
  }

  .audience-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.45rem 0.9rem;
    border-radius: 2rem;
    margin-bottom: 1.75rem;
    width: fit-content;
  }

  .audience-label--prague {
    background: rgba(215, 38, 61, 0.2);
    color: #f28090;
    border: 1px solid rgba(215, 38, 61, 0.35);
  }

  .audience-label--outside {
    background: rgba(42, 90, 140, 0.3);
    color: #7fb3e0;
    border: 1px solid rgba(42, 90, 140, 0.45);
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .step-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: background 0.2s;
  }

  .step-card:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .step-number {
    font-size: 1.75rem;
    font-weight: 900;
    font-family: var(--font-heading);
    line-height: 1;
    flex-shrink: 0;
  }

  .step-card--prague .step-number {
    color: var(--color-primary);
  }

  .step-card--outside .step-number {
    color: var(--color-secondary-light);
  }

  .step-title {
    font-size: 1.05rem;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .step-desc {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
  }

  .step-link {
    color: #7fb3e0;
    text-decoration: underline;
    word-break: break-all;
  }

  .step-link:hover {
    color: #a8cfee;
  }

  .step-list {
    margin-top: 0.5rem;
    padding-left: 1.2rem;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .audience-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem 0;
    }

    .audience-divider {
      height: 1px;
      width: 100%;
      background: rgba(255, 255, 255, 0.12);
    }
  }
</style>
