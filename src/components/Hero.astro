---
// Hero section component
---

<section class="hero" aria-label="Úvodní sekce">
  <div class="hero-bg" aria-hidden="true"></div>

  <!-- Event selector dropdown (top-right) -->
  <div class="event-selector" id="eventSelector" aria-label="Výběr akce">
    <button class="event-selector__btn" id="eventSelectorBtn" aria-haspopup="listbox" aria-expanded="false">
      <span class="event-selector__live" id="selectorLiveIndicator" aria-hidden="true"></span>
      <span class="event-selector__label" id="selectorLabel">Načítám…</span>
      <svg class="event-selector__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <ul class="event-selector__menu" id="eventSelectorMenu" role="listbox" aria-label="Dostupné akce">
      <li class="event-selector__option" role="option" data-event="june2026" aria-selected="false">
        <span class="event-selector__dot event-selector__dot--live" aria-hidden="true"></span>
        <span class="event-selector__option-text">
          <strong>Vládo, wake up!</strong>
          <small>po 15. června · 10:00</small>
        </span>
      </li>
      <li class="event-selector__option" role="option" data-event="april2025" aria-selected="false">
        <span class="event-selector__dot event-selector__dot--past" aria-hidden="true"></span>
        <span class="event-selector__option-text">
          <strong>Walkout za média</strong>
          <small>st 22. dubna · 11:59</small>
        </span>
      </li>
    </ul>
  </div>

  <div class="container">
    <div class="hero-content">
      <p class="hero-label">Studentská iniciativa za veřejnoprávní média · StRada FF UK</p>
      <h1 class="hero-title">MEDIA&nbsp;</br><span class="highlight">NEDAME!</span></h1>

      <!-- Event panel: June 2026 -->
      <div class="event-panel" id="panel-june2026" hidden>
        <p class="hero-subtitle">
          Reagujeme na nový zákon ohrožující financování veřejnoprávních médií.
          Přidejte se k protestu – Vládo, čas se probudit!
        </p>
        <a
          href="https://www.facebook.com/events/924779877285349/"
          class="hero-event-banner"
          aria-label="Informace o akci – otevřít Facebook událost"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="event-detail">
            <i class="fa-solid fa-calendar-days event-icon" aria-hidden="true"></i>
            <span>pondělí <strong>15. června</strong> v <strong>10:00</strong></span>
          </div>
          <div class="event-detail">
            <i class="fa-solid fa-location-dot event-icon" aria-hidden="true"></i>
            <span>Letenské sady · Strakova Akademie</span>
          </div>
          <div class="event-detail">
            <i class="fa-solid fa-person-walking event-icon" aria-hidden="true"></i>
            <span>sraz · pochod · spuštění budíků</span>
          </div>
        </a>
        <div class="hero-actions">
          <a href="/TZ_wake_up.pdf" class="btn btn-outline-white btn-doc" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Tisková zpráva
          </a>
        </div>
        <p class="hero-spread">
          Budeme rádi za šíření. Dejte si to vědět mezi sebou, ve škole, proberte to s pedagogy nebo ve školních radách.
          Jedná se o studentskou iniciativu, ale může se k ní přidat každý, kdo cítí závažnost této situace.
        </p>
      </div>

      <!-- Event panel: April 2025 -->
      <div class="event-panel" id="panel-april2025" hidden>
        <p class="hero-subtitle">
          Vyzýváme veškeré studenstvo k protestnímu walkoutu na obranu veřejnoprávních médií.
          Přidejte se! Je za minutu dvanáct!
        </p>
        <a
          href="https://www.facebook.com/events/s/media-nedame/1349185803730756/?rdid=0GoJbEjAxOx7B6jj&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1DM14J5jVX#"
          class="hero-event-banner"
          aria-label="Informace o akci – otevřít Facebook událost"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="event-detail">
            <i class="fa-solid fa-calendar-days event-icon" aria-hidden="true"></i>
            <span>středa <strong>22. dubna</strong> v <strong>11:59</strong></span>
          </div>
          <div class="event-detail">
            <i class="fa-solid fa-location-dot event-icon" aria-hidden="true"></i>
            <span>náměstí Jana Palacha</span>
          </div>
          <div class="event-detail">
            <i class="fa-solid fa-person-walking event-icon" aria-hidden="true"></i>
            <span>odchod z výuky · pochod k ministerstvu kultury</span>
          </div>
        </a>
        <div class="hero-actions">
          <a href="/tiskova-zprava.pdf" class="btn btn-outline-white btn-doc" download aria-label="Stáhnout tisková zpráva jako PDF">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Tisková zpráva
          </a>
          <a href="/Prohlášení Média nedáme!.pdf" class="btn btn-outline-white btn-doc" download aria-label="Stáhnout prohlášení jako PDF">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Prohlášení
          </a>
          <a href="/mapa+harmonogram.pdf" class="btn btn-outline-white btn-doc" download aria-label="Stáhnout mapu a program jako PDF">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Mapa + program
          </a>
        </div>
        <p class="hero-spread">
          Budeme rádi za šíření. Dejte si to vědět mezi sebou, ve škole, proberte to s pedagogy nebo ve školních radách.
          Jedná se o studentskou iniciativu, ale může se k ní přidat každý, kdo cítí závažnost této situace.
        </p>
      </div>

    </div>
  </div>
</section>

<script>
  // Event definitions: id → { date, label, shortDate }
  const EVENTS = [
    { id: 'june2026', date: new Date('2026-06-15T23:59:59'), label: 'Vládo, wake up!', shortDate: 'po 15. června · 10:00' },
    { id: 'april2025', date: new Date('2025-04-22T23:59:59'), label: 'Walkout za média', shortDate: 'st 22. dubna · 11:59' },
  ];

  const now = new Date();

  function isUpcoming(event: { date: Date }) {
    return event.date >= now;
  }

  // Find the default event: first upcoming (events sorted newest first), fallback to first
  const defaultEvent = EVENTS.find(isUpcoming) ?? EVENTS[0];

  // DOM refs
  const selectorBtn = document.getElementById('eventSelectorBtn') as HTMLButtonElement;
  const selectorMenu = document.getElementById('eventSelectorMenu') as HTMLUListElement;
  const selectorLabel = document.getElementById('selectorLabel') as HTMLSpanElement;
  const selectorLive = document.getElementById('selectorLiveIndicator') as HTMLSpanElement;
  const options = Array.from(document.querySelectorAll<HTMLLIElement>('.event-selector__option'));

  function activateEvent(eventId: string) {
    // Hide all panels
    document.querySelectorAll<HTMLDivElement>('.event-panel').forEach(p => { p.hidden = true; });
    // Show target panel
    const panel = document.getElementById(`panel-${eventId}`);
    if (panel) panel.hidden = false;

    // Update options aria-selected
    options.forEach(opt => {
      opt.setAttribute('aria-selected', opt.dataset.event === eventId ? 'true' : 'false');
    });

    // Update button label + live indicator
    const ev = EVENTS.find(e => e.id === eventId);
    if (ev) {
      selectorLabel.textContent = ev.label;
      if (isUpcoming(ev)) {
        selectorLive.classList.add('event-selector__live--active');
        selectorLive.setAttribute('title', 'Připravovaná akce');
      } else {
        selectorLive.classList.remove('event-selector__live--active');
        selectorLive.setAttribute('title', 'Proběhlá akce');
      }
    }
  }

  // Initialise with default event
  activateEvent(defaultEvent.id);

  // Toggle dropdown
  selectorBtn.addEventListener('click', () => {
    const expanded = selectorBtn.getAttribute('aria-expanded') === 'true';
    selectorBtn.setAttribute('aria-expanded', String(!expanded));
    selectorMenu.classList.toggle('event-selector__menu--open', !expanded);
  });

  // Select option
  options.forEach(opt => {
    opt.addEventListener('click', () => {
      const eventId = opt.dataset.event;
      if (eventId) activateEvent(eventId);
      selectorBtn.setAttribute('aria-expanded', 'false');
      selectorMenu.classList.remove('event-selector__menu--open');
    });
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    const selector = document.getElementById('eventSelector');
    if (selector && !selector.contains(e.target as Node)) {
      selectorBtn.setAttribute('aria-expanded', 'false');
      selectorMenu.classList.remove('event-selector__menu--open');
    }
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding-block: 6rem 5rem;
    overflow: hidden;
    color: #fff;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f0f0f 0%, #1a0a1a 50%, #0a1a0a 100%);
    z-index: 0;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(255, 0, 204, 0.2) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(127, 255, 0, 0.15) 0%, transparent 45%);
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 960px;
  }

  /* ── Event selector ── */
  .event-selector {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 10;
  }

  .event-selector__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 2rem;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.45rem 0.9rem 0.45rem 0.7rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .event-selector__btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .event-selector__chevron {
    opacity: 0.7;
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .event-selector__btn[aria-expanded="true"] .event-selector__chevron {
    transform: rotate(180deg);
  }

  /* Live indicator dot inside button */
  .event-selector__live {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
    transition: background 0.3s;
  }

  .event-selector__live--active {
    background: var(--color-primary);
    animation: semaphore-pulse 2s ease-in-out infinite;
  }

  @keyframes semaphore-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(127, 255, 0, 0.7); }
    50%       { box-shadow: 0 0 0 5px rgba(127, 255, 0, 0); }
  }

  /* Dropdown menu */
  .event-selector__menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 220px;
    background: rgba(20, 10, 20, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.75rem;
    padding: 0.4rem 0;
    list-style: none;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .event-selector__menu--open {
    display: block;
  }

  .event-selector__option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    cursor: pointer;
    transition: background 0.15s;
  }

  .event-selector__option:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .event-selector__option[aria-selected="true"] {
    background: rgba(127, 255, 0, 0.08);
  }

  /* Semaphore dot in options */
  .event-selector__dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .event-selector__dot--live {
    background: var(--color-primary);
    animation: semaphore-pulse 2s ease-in-out infinite;
  }

  .event-selector__dot--past {
    background: rgba(255, 255, 255, 0.3);
  }

  .event-selector__option-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .event-selector__option-text strong {
    font-size: 0.85rem;
    color: #fff;
    font-weight: 600;
  }

  .event-selector__option-text small {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
  }

  /* ── Hero content ── */
  .hero-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 1.25rem;
    border-left: 3px solid var(--color-primary);
    padding-left: 0.75rem;
  }

  .hero-title {
    font-family: 'Black Han Sans', sans-serif;
    font-size: clamp(2rem, 10vw, 5.5rem);
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    padding-right: 0.05em;
    overflow-wrap: break-word;
    color: var(--color-secondary);
  }

  .highlight {
    color: var(--color-primary);
    position: relative;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.8);
    max-width: 58ch;
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .hero-event-banner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius);
    padding: 1rem 1.5rem;
    margin-bottom: 2rem;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .hero-event-banner:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .event-detail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .event-detail strong {
    color: #fff;
  }

  .event-icon {
    font-size: 1rem;
    color: var(--color-primary);
    width: 1.25em;
    text-align: center;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .btn-doc {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .btn-doc svg {
    flex-shrink: 0;
  }

  /* Disabled button tooltip wrapper */
  .btn-soon-wrap {
    position: relative;
    display: inline-flex;
  }

  .btn-soon-wrap button[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .btn-soon-wrap::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: rgba(20, 10, 20, 0.92);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    padding: 0.3rem 0.65rem;
    border-radius: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s, transform 0.15s;
    z-index: 10;
  }

  .btn-soon-wrap:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .hero-spread {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    max-width: 60ch;
    line-height: 1.6;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 1.25rem;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-block: 5rem 4rem;
    }

    .hero-label {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
    }

    .hero-event-banner {
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
      text-align: center;
    }

    .event-selector {
      top: 1rem;
      right: 1rem;
    }
  }

  @media (max-width: 400px) {
    .hero {
      padding-block: 4.5rem 3rem;
    }

    .hero-title {
      font-size: clamp(1.75rem, 11vw, 2.5rem);
    }

    .hero-subtitle {
      font-size: 0.95rem;
    }

    .event-selector__btn {
      font-size: 0.72rem;
      padding: 0.4rem 0.7rem 0.4rem 0.6rem;
    }
  }
</style>
