---
import XLSX from 'xlsx';
import { join } from 'path';
import { statSync } from 'fs';

const filePath = join(process.cwd(), 'public', 'school_protests.xlsx');
const workbook = XLSX.readFile(filePath);
const sheet = workbook.Sheets[workbook.SheetNames[0]];
const lastModified = statSync(filePath).mtime;

interface SchoolRow {
  'Název školy / univerzity': string;
  'Město': string;
  'Odhad účastníků': string;
}

const rawData = XLSX.utils.sheet_to_json<SchoolRow>(sheet);

// Fisher-Yates shuffle
const schools = [...rawData];
for (let i = schools.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [schools[i], schools[j]] = [schools[j], schools[i]];
}

const countWord = schools.length === 1 ? 'škola' : (schools.length >= 2 && schools.length <= 4) ? 'školy' : 'škol';

const lastModifiedStr = lastModified.toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<section id="protestuji-s-nami" class="protest-schools-section">
  <div class="container">
    <header class="protest-schools-header">
      <p class="section-label">Protestují s námi</p>
      <h2 class="section-title">Jaká města a školy nás podpořily?</h2>
      <p class="section-subtitle">
        Školy, které v rámci iniciativy Média nedáme! pořádají vlastní akce.
      </p>
    </header>

    <div id="protest-schools-table-wrap" class="protest-schools-table-wrap">
      <table class="protest-schools-table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Škola / univerzita</th>
            <th scope="col">Město</th>
            <th scope="col">Odhad účastníků</th>
          </tr>
        </thead>
        <tbody id="protest-schools-tbody">
          {schools.map((school, index) => (
            <tr>
              <td class="col-num">{index + 1}</td>
              <td class="col-school" title={school['Název školy / univerzity']}>{school['Název školy / univerzity']}</td>
              <td class="col-city" title={school['Město']}>{school['Město']}</td>
              <td class="col-count" title={school['Odhad účastníků']}>{school['Odhad účastníků']}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p id="protest-schools-count" class="protest-schools-count">
      Celkem <strong>{schools.length}</strong> {countWord}
    </p>
    <p id="protest-schools-updated" class="protest-schools-updated">Poslední aktualizace: {lastModifiedStr}</p>
  </div>
</section>

<style is:global>
  .protest-schools-section {
    padding: 5rem 0;
    background: var(--color-bg);
  }

  .protest-schools-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .protest-schools-table-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow);
  }

  .protest-schools-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .protest-schools-table thead,
  .protest-schools-table tbody {
    display: block;
    width: 100%;
  }

  .protest-schools-table tbody {
    max-height: calc(10 * 46px);
    overflow-y: scroll;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .protest-schools-table tbody::-webkit-scrollbar {
    width: 6px;
  }

  .protest-schools-table tbody::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 3px;
  }

  .protest-schools-table thead tr,
  .protest-schools-table tbody tr {
    display: table;
    width: 100%;
    table-layout: fixed;
  }

  /* Compensate for scrollbar width so thead aligns with tbody */
  .protest-schools-table thead tr {
    width: 100%;
  }

  /* Explicit column widths – must match between th and td */
  .protest-schools-table th:nth-child(1),
  .protest-schools-table td:nth-child(1) { width: 3rem; }

  .protest-schools-table th:nth-child(2),
  .protest-schools-table td:nth-child(2) { width: 55%; }

  .protest-schools-table th:nth-child(3),
  .protest-schools-table td:nth-child(3) { width: 22%; }

  .protest-schools-table th:nth-child(4),
  .protest-schools-table td:nth-child(4) { width: 18%; }

  .protest-schools-table thead {
    background: var(--color-bg-dark);
    color: #fff;
  }

  .protest-schools-table thead th {
    padding: 0.85rem 1.75rem;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .protest-schools-table thead th:nth-child(1) {
    text-align: center;
  }

  .protest-schools-table thead th:nth-child(4) {
    text-align: right;
  }

  .protest-schools-table tbody tr {
    border-bottom: 1px solid var(--color-border);
    transition: background 0.12s;
  }

  .protest-schools-table tbody tr:last-child {
    border-bottom: none;
  }

  .protest-schools-table tbody tr:hover {
    background: var(--color-bg-alt);
  }

  .protest-schools-table tbody tr:nth-child(even) {
    background: var(--color-bg-alt);
  }

  .protest-schools-table tbody tr:nth-child(even):hover {
    background: #ececec;
  }

  .protest-schools-table td {
    padding: 0.75rem 1.75rem;
    color: var(--color-text);
    vertical-align: middle;
  }

  .col-num {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    text-align: center;
  }

  .col-school {
    font-weight: 500;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .col-city {
    color: var(--color-text-light);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .col-count {
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .protest-schools-table td.col-count {
    text-align: right;
  }

  .protest-schools-count {
    margin-top: 1.25rem;
    text-align: center;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .protest-schools-count strong {
    color: var(--color-text);
  }

  .protest-schools-updated {
    margin-top: 0.4rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 600px) {
    .protest-schools-table thead th:last-child,
    .protest-schools-table td.col-count {
      display: none;
    }
  }

  /* Loading overlay */
  .protest-schools-table-wrap.is-loading {
    position: relative;
    pointer-events: none;
    min-height: 6rem;
  }

  .protest-schools-table-wrap.is-loading::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.65);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .protest-schools-table-wrap.is-loading::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    margin: -1rem 0 0 -1rem;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: ps-spin 0.7s linear infinite;
  }

  @keyframes ps-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const SHEET_CSV_URL =
    'https://docs.google.com/spreadsheets/d/1D9MXxAX8WHdqyVgKzwU8YtlUGJexjoPptr3Op_wkXGk/export?format=csv';

  /** Parse a single CSV line respecting double-quoted fields that may contain commas. */
  function parseCsvLine(line: string): string[] {
    const fields: string[] = [];
    let current = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      if (inQuotes) {
        if (ch === '"' && line[i + 1] === '"') {
          current += '"';
          i++;
        } else if (ch === '"') {
          inQuotes = false;
        } else {
          current += ch;
        }
      } else {
        if (ch === '"') {
          inQuotes = true;
        } else if (ch === ',') {
          fields.push(current);
          current = '';
        } else {
          current += ch;
        }
      }
    }
    fields.push(current);
    return fields;
  }

  /** Fisher-Yates in-place shuffle. */
  function shuffle<T>(arr: T[]): T[] {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function countWord(n: number): string {
    if (n === 1) return 'škola';
    if (n >= 2 && n <= 4) return 'školy';
    return 'škol';
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function loadFromGoogleSheets() {
    const tableWrap = document.getElementById('protest-schools-table-wrap');
    const tbody = document.getElementById('protest-schools-tbody');
    const countEl = document.getElementById('protest-schools-count');
    const updatedEl = document.getElementById('protest-schools-updated');

    if (!tableWrap || !tbody || !countEl || !updatedEl) return;

    tableWrap.classList.add('is-loading');

    try {
      const response = await fetch(SHEET_CSV_URL);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const text = await response.text();
      const lines = text.split(/\r?\n/).filter(l => l.trim() !== '');
      if (lines.length < 2) throw new Error('No data rows');

      const headers = parseCsvLine(lines[0]);
      const colSchool = headers.indexOf('Název školy / univerzity');
      const colCity = headers.indexOf('Město');
      const colCount = headers.indexOf('Odhad účastníků');

      if (colSchool === -1 || colCity === -1 || colCount === -1) {
        throw new Error('Expected columns not found in sheet');
      }

      interface Row { school: string; city: string; count: string; }
      const rows: Row[] = lines.slice(1).map(line => {
        const fields = parseCsvLine(line);
        return {
          school: fields[colSchool] ?? '',
          city: fields[colCity] ?? '',
          count: fields[colCount] ?? '',
        };
      }).filter(row => row.school.trim() !== '' || row.city.trim() !== '' || row.count.trim() !== '');

      shuffle(rows);

      tbody.innerHTML = rows.map((row, i) => `
        <tr>
          <td class="col-num">${i + 1}</td>
          <td class="col-school" title="${escapeHtml(row.school)}">${escapeHtml(row.school)}</td>
          <td class="col-city" title="${escapeHtml(row.city)}">${escapeHtml(row.city)}</td>
          <td class="col-count" title="${escapeHtml(row.count)}">${escapeHtml(row.count)}</td>
        </tr>`).join('');

      countEl.innerHTML = `Celkem <strong>${rows.length}</strong> ${countWord(rows.length)}`;

      const now = new Date().toLocaleDateString('cs-CZ', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
      updatedEl.textContent = `Poslední aktualizace: ${now}`;
    } catch (_err) {
      // Silently fall back to the build-time Excel data already in the DOM
    } finally {
      tableWrap.classList.remove('is-loading');
    }
  }

  loadFromGoogleSheets();
</script>
