---
// Footer component
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Média nedáme – domů">
        <img src="/logo.jpeg" alt="Média nedáme logo" width="32" height="32" style="border-radius:50%;object-fit:cover;" />
        <span>Média<strong>nedáme!</strong></span>
      </a>
      <p class="footer-tagline">
        Studentská iniciativa za ochranu veřejnoprávních médií. StRada FF UK.
      </p>
      <div class="footer-social">
        <a
          href="https://www.instagram.com/media.nedame/"
          class="social-link"
          aria-label="Instagram"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        </a>
        <a
          href="https://www.facebook.com/events/s/media-nedame/1349185803730756/?rdid=0GoJbEjAxOx7B6jj&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1DM14J5jVX#"
          class="social-link"
          aria-label="Facebook"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()} Média nedáme. Všechna práva vyhrazena.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-dark);
    color: rgba(255, 255, 255, 0.7);
    padding-top: 2rem;
    padding-bottom: 1.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.15rem;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .footer-logo strong {
    color: var(--color-primary);
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .footer-social {
    display: flex;
    flex-direction: row;
    gap: 0.75rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    transition: background 0.15s;
  }

  .social-link:hover {
    background: var(--color-primary);
  }

  .footer-nav-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1rem;
    font-family: var(--font-body);
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav a {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.15s;
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-disclaimer {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.4);
    text-align: right;
  }

  @media (max-width: 900px) {
    .footer-grid {
      gap: 2rem;
    }
  }

  @media (max-width: 500px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-disclaimer {
      text-align: left;
    }
  }
</style>
