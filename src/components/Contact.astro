---
// Contact section
---

<section id="kontakt" class="contact-section">
  <div class="container">
    <header class="contact-header">
      <p class="section-label">Kontakt</p>
      <h2 class="section-title">Spojte se s námi</h2>
      <p class="section-subtitle">Máte dotaz nebo zájem o spolupráci? Napište nám.</p>
    </header>

    <div class="contact-grid">
      <div class="contact-card">
        <h3 class="contact-card-title">Obecný kontakt</h3>
        <p class="contact-card-body">
          <a href="mailto:medianedame@gmail.com" class="contact-link">medianedame@gmail.com</a>
        </p>
      </div>

      <div class="contact-card">
        <h3 class="contact-card-title">Tiskový mluvčí</h3>
        <p class="contact-card-name">Tomáš Stráník</p>
        <p class="contact-card-body">
          <a href="tel:+420702139960" class="contact-link">+420 702 139 960</a><br />
          <a href="mailto:stranikt@ff.cuni.cz" class="contact-link">stranikt@ff.cuni.cz</a>
        </p>
      </div>

      <div class="contact-card">
        <h3 class="contact-card-title">Tisková koordinátorka</h3>
        <p class="contact-card-name">Karla Ismayilzada</p>
        <p class="contact-card-body">
          <a href="tel:+420720134294" class="contact-link">+420 720 134 294</a><br />
          <span class="contact-link">karla.ismayilzada</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 5rem 0;
    background: var(--color-bg-alt);
  }

  .contact-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .contact-card {
    background: var(--color-bg);
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    padding: 1.75rem;
    box-shadow: var(--shadow);
  }

  .contact-card-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .contact-card-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .contact-card-body {
    font-size: 0.95rem;
    line-height: 2;
    color: var(--color-text-light);
  }

  .contact-link {
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.15s;
    word-break: break-all;
  }

  .contact-link:hover {
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
