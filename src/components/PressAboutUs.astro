  }

  .press-acc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .press-acc-list li {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text);
    padding: 0.35rem 0.8rem;
