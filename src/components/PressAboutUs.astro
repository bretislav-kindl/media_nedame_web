<section id="napsali-o-nas" class="press-about-us">
  <div class="container">
    <header class="press-about-us-header">
      <p class="section-label">Napsali o nás</p>
      <h2 class="section-title">Máme zahraniční dosah!</h2>
      <p class="section-subtitle">
        Náš hlas byl slyšet až ve Spojených státech, ale také na Slovensku, ve Spojeném království a dalších zemích v Evropě.
      </p>
    </header>

    <h3 class="press-accordion-heading">Top média, která o nás napsala:</h3>

    <dl class="press-accordion">
      {accordionItems.map((item, index) => (
        <div class="press-acc-item">
          <dt>
            <button
              class="press-acc-btn"
              aria-expanded="false"
              aria-controls={`press-acc-${index}`}
            >
              <span>{item.title}</span>
              <i class="fa-solid fa-plus press-acc-icon" aria-hidden="true"></i>
            </button>
          </dt>
          <dd class="press-acc-body" id={`press-acc-${index}`} hidden>
            <ul class="press-acc-list">
              {item.agencies.map(agency => <li>{agency}</li>)}
            </ul>
          </dd>
        </div>
      ))}
    </dl>

    <div class="press-fight-block">
      <h3 class="press-fight-title about-subheading">Varování: Svoboda médií je v sázce</h3>
      <p class="press-fight-text">
        Ohrožení nezávislosti veřejnoprávních médií vnímají i <a href="https://rsf.org/en/czechia-government-s-chaotic-reform-public-broadcasters-raises-alarm-rsf-and-partners-call-european" target="_blank" rel="noopener noreferrer">mezinárodní organizace</a>. Česká republika se nadále umisťuje na předních pozicích v žebříčku svobody médií mezi zeměmi z celého světa <a href="https://rsf.org/en/country-czechia" target="_blank" rel="noopener noreferrer">(10. místo celosvětově, RSF 2025)</a>. To se může rychle změnit. Mezinárodní organizace monitorující nezávislost médií v čele s International Press Institute vydaly dne 22.4. společné <a href="https://rsf.org/sites/default/files/medias/file/2026/04/Czechia_%20Public%20media%20funding%20bill%20raises%20concerns%20over%20compatibility%20with%20EMFA.pdf" target="_blank" rel="noopener noreferrer">prohlášení</a> , ve kterém varují před ohrožením nezávislosti mediálních institucí. Zmiňují v něm také, že ČT a ČRo jsou v Evropě uznávány, jako modelové příklady kvalitního veřejnoprávního vysílání. Upozorňují na to, že návrh zákona porušuje článek 5 Evropského aktu o svobodě médií, a vyzývají Evropskou komisi, aby návrh prověřila.
      </p>
    </div>
  </div>
</section>

<script>
  const accButtons = document.querySelectorAll<HTMLButtonElement>('.press-acc-btn');

  accButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const bodyId = btn.getAttribute('aria-controls');
      const body = bodyId ? document.getElementById(bodyId) : null;

      // Close all other items
      accButtons.forEach((other) => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          const otherId = other.getAttribute('aria-controls');
          const otherBody = otherId ? document.getElementById(otherId) : null;
          if (otherBody) otherBody.hidden = true;
          const otherIcon = other.querySelector('.press-acc-icon');
          if (otherIcon) {
            otherIcon.classList.remove('fa-minus');
            otherIcon.classList.add('fa-plus');
          }
        }
      });

      btn.setAttribute('aria-expanded', String(!expanded));
      if (body) body.hidden = expanded;
      const icon = btn.querySelector('.press-acc-icon');
      if (icon) {
        if (expanded) {
          icon.classList.remove('fa-minus');
          icon.classList.add('fa-plus');
        } else {
          icon.classList.remove('fa-plus');
          icon.classList.add('fa-minus');
        }
      }
    });
  });
</script>

<style>
