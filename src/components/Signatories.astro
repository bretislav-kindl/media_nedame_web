---
// Signatories / Supporters section component

const signatories = [
  {
    name: 'Jana Nováková',
    role: 'Novinářka, investigativní redakce',
    quote: 'Bez svobodných médií není demokracie. Podepisuji, protože na tom záleží.',
  },
  {
    name: 'Marek Svoboda',
    role: 'Spisovatel a publicista',
    quote:
      'Literatura a žurnalistika jsou sestry. Obě hledají pravdu, obě potřebují svobodu.',
  },
  {
    name: 'Petra Horáčková',
    role: 'Ředitelka divadla',
    quote:
      'Kultura a svobodná média jdou ruku v ruce. Bez obojího ztrácíme jako společnost hlas.',
  },
  {
    name: 'Ondřej Fiala',
    role: 'Dokumentarista',
    quote:
      'Každý útok na novináře je útokem na nás všechny. Proto stojím za touto iniciativou.',
  },
  {
    name: 'Lucie Marková',
    role: 'Akademička, FSV UK',
    quote:
      'Výzkumy potvrzují: kde upadají svobodná média, upadá i demokracie. To není teorie.',
  },
  {
    name: 'Tomáš Blažek',
    role: 'Fotoreportér',
    quote: 'Moje fotografie by neexistovaly bez svobody tisku. Bráním ji, protože ji potřebuji.',
  },
];
---

<section id="signatari" class="signatories">
  <div class="container">
    <header class="signatories-header">
      <p class="section-label">Signatáři</p>
      <h2 class="section-title">Co říkají lidé za námi</h2>
      <p class="section-subtitle">
        K iniciativě se připojili studenti, akademici, novináři i kulturní osobnosti
        odhodlaní bránit veřejnoprávní média.
      </p>
    </header>
    <div class="testimonials-grid">
      {
        signatories.map((person) => (
          <blockquote class="testimonial">
            <p class="testimonial-quote">{person.quote}</p>
            <footer class="testimonial-author">
              <strong class="author-name">{person.name}</strong>
              <span class="author-role">{person.role}</span>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<style>
  .signatories {
    background: var(--color-bg-alt);
  }

  .signatories-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .signatories-header .section-subtitle {
    margin-inline: auto;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .testimonial {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: var(--shadow);
  }

  .testimonial-quote {
    font-style: italic;
    font-size: 0.97rem;
    color: var(--color-text-light);
    line-height: 1.7;
    flex: 1;
    position: relative;
    padding-top: 1.5rem;
  }

  .testimonial-quote::before {
    content: '\201C';
    position: absolute;
    top: -0.25rem;
    left: 0;
    font-size: 3rem;
    line-height: 1;
    color: var(--color-primary);
    font-family: var(--font-heading);
    opacity: 0.4;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .author-name {
    font-size: 0.95rem;
    color: var(--color-secondary);
  }

  .author-role {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .signatories-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-text {
    font-size: 1.2rem;
    color: var(--color-secondary);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
