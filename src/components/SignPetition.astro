---
// Signature / Sign petition section component
---

<section id="podpis" class="sign-section">
  <div class="container">
    <div class="sign-grid">
      <div class="sign-info">
        <p class="section-label">Přidejte svůj hlas</p>
        <h2 class="section-title">Podepište výzvu za svobodná média</h2>
        <p class="sign-description">
          Vaším podpisem vyjadřujete souhlas s tím, že svobodná a nezávislá média jsou
          nezbytná pro fungování demokratické společnosti, a vyzýváte politiky a instituce,
          aby jejich nezávislost aktivně chránili.
        </p>
        <ul class="sign-benefits" aria-label="Co podpisem vyjadřujete">
          <li>
            <span aria-hidden="true">✓</span> Odmítáte politické tlaky na redakce a veřejnoprávní média
          </li>
          <li>
            <span aria-hidden="true">✓</span> Podporujete ochranu novinářů před zastrašováním
          </li>
          <li>
            <span aria-hidden="true">✓</span> Žádáte transparentní pravidla pro vlastnictví médií
          </li>
          <li>
            <span aria-hidden="true">✓</span> Stojíte za zachováním plurality mediálního trhu
          </li>
        </ul>
        <p class="sign-privacy">
          🔒 Vaše údaje jsou zpracovávány v souladu s GDPR a nebudou sdíleny se třetími stranami.
        </p>
      </div>
      <div class="sign-form-wrapper">
        <form class="sign-form" id="petition-form" novalidate>
          <div class="form-group">
            <label for="first-name">Jméno *</label>
            <input
              type="text"
              id="first-name"
              name="firstName"
              placeholder="Jana"
              required
              autocomplete="given-name"
            />
          </div>
          <div class="form-group">
            <label for="last-name">Příjmení *</label>
            <input
              type="text"
              id="last-name"
              name="lastName"
              placeholder="Nováková"
              required
              autocomplete="family-name"
            />
          </div>
          <div class="form-group">
            <label for="email">E-mail *</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="jana@priklad.cz"
              required
              autocomplete="email"
            />
          </div>
          <div class="form-group">
            <label for="city">Město / obec</label>
            <input
              type="text"
              id="city"
              name="city"
              placeholder="Praha"
              autocomplete="address-level2"
            />
          </div>
          <div class="form-group form-group--checkbox">
            <input type="checkbox" id="public" name="public" />
            <label for="public">Souhlasím se zveřejněním svého jména a města</label>
          </div>
          <div class="form-group form-group--checkbox">
            <input type="checkbox" id="gdpr" name="gdpr" required />
            <label for="gdpr">
              Souhlasím se <a href="/gdpr" class="form-link">zpracováním osobních údajů</a> *
            </label>
          </div>
          <div class="form-group form-group--checkbox">
            <input type="checkbox" id="newsletter" name="newsletter" />
            <label for="newsletter">
              Chci dostávat aktualizace o iniciativě na svůj e-mail
            </label>
          </div>
          <button type="submit" class="btn btn-primary sign-submit">
            Podepsat výzvu
          </button>
          <div class="form-success" id="form-success" hidden aria-live="polite">
            <span aria-hidden="true">🎉</span>
            <strong>Děkujeme!</strong> Váš podpis byl úspěšně přijat.
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('petition-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const submitBtn = form.querySelector('[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Odesílám…';
    }

    // TODO: Replace with actual form submission endpoint
    // e.g. Netlify Forms, Formspree, or custom API
    await new Promise((resolve) => setTimeout(resolve, 1000));

    if (successMsg) {
      successMsg.hidden = false;
    }
    form.reset();
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Podepsat výzvu';
    }
  });
</script>

<style>
  .sign-section {
    background: var(--color-bg);
  }

  .sign-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .sign-description {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .sign-benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
  }

  .sign-benefits li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    font-size: 0.95rem;
    color: var(--color-text-light);
  }

  .sign-benefits li span {
    color: var(--color-primary);
    font-weight: 700;
    flex-shrink: 0;
  }

  .sign-privacy {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    padding: 0.75rem 1rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    border-left: 3px solid var(--color-border);
  }

  .sign-form-wrapper {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 1.5);
    padding: 2.5rem;
    box-shadow: var(--shadow);
  }

  .sign-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .form-group input[type='text'],
  .form-group input[type='email'] {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.95rem;
    color: var(--color-text);
    background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
  }

  .form-group input[type='text']:focus,
  .form-group input[type='email']:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(215, 38, 61, 0.12);
  }

  .form-group--checkbox {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .form-group--checkbox input[type='checkbox'] {
    margin-top: 0.15rem;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    accent-color: var(--color-primary);
  }

  .form-group--checkbox label {
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--color-text-light);
    cursor: pointer;
  }

  .form-link {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .sign-submit {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.9rem;
    font-size: 1rem;
  }

  .sign-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .form-success {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: #e8f5e9;
    border: 1px solid #a5d6a7;
    border-radius: var(--radius);
    color: #2e7d32;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .sign-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
