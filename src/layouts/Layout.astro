---
// Kostra stránky: hlavička HTML, písma, zrnitost obrazu, ukazatel postupu, intro.
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const site = 'https://medianedame.cz';
const ogImage = `${site}/og-image.jpg`;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={`${site}/`} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Média nedáme!" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anton-latin-ext-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/img/hero-3-11-vaclavak-noc.jpg" as="image" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>
    <!-- Intro „Za minutu dvanáct“: jen při první návštěvě v relaci, dá se přeskočit -->
    <div class="intro" id="intro" aria-hidden="true">
      <div class="sh t"></div>
      <div class="sh b"></div>
      <div class="tc" id="tc">11<b>:</b>57</div>
      <div class="cap">Za minutu dvanáct</div>
      <button class="skip" id="skip" type="button">Přeskočit intro</button>
    </div>
    <slot />
    <script src="../scripts/main.js"></script>
  </body>
</html>
