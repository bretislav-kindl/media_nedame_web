---
// Celá stránka: pořadí sekcí shora dolů
import Layout from '../layouts/Layout.astro';
import Navigace from '../components/Navigace.astro';
import Uvod from '../components/Uvod.astro';
import ONas from '../components/ONas.astro';
import Mezihra from '../components/Mezihra.astro';
import Akce from '../components/Akce.astro';
import Zapojit from '../components/Zapojit.astro';
import CoSeStalo from '../components/CoSeStalo.astro';
import Argumenty from '../components/Argumenty.astro';
import Data from '../components/Data.astro';
import Pozadujeme from '../components/Pozadujeme.astro';
import Otazky from '../components/Otazky.astro';
import Kontakt from '../components/Kontakt.astro';
import Paticka from '../components/Paticka.astro';
---

<Layout
  title="Média nedáme! Studentská iniciativa za veřejnoprávní média"
  description="Vláda chce zrušit poplatky a platit Českou televizi a Český rozhlas ze státního rozpočtu. Studentská iniciativa Média nedáme! hájí nezávislost veřejnoprávních médií."
>
  <Navigace />
  <main>
    <Uvod />
    <ONas />
    <Mezihra klic="walkout" />
    <Akce />
    <Zapojit />
    <CoSeStalo />
    <Mezihra klic="skoly" />
    <Argumenty />
    <Data />
    <Pozadujeme />
    <Otazky />
    <Kontakt />
  </main>
  <Paticka />
</Layout>
